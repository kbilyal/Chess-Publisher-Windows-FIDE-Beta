@@ -12946,6 +12967,31 @@ function getPlayerRegistrationDeletedFromRound(player){
   const n=parseInt(player?.registrationDeletedFromRound);
   return Number.isInteger(n)&&n>0 ? n : 1;
 }
+
+// beta.88 TEC Q170/Q197/Q198 — presentation/status layer only.
+// Withdrawal is derived from the existing post-start registration tombstone.
+// Expulsion is an explicit arbiter status and may optionally hide the player
+// from standings while every historical board/result remains untouched.
+function getPlayerTournamentStandingStatus(playerOrRow){
+  const player=playerOrRow?.sourcePlayer||playerOrRow;
+  if(!player) return "active";
+  if(String(player.tournamentStatus||"").toLowerCase()==="expelled") return "expelled";
+  if(isPlayerRegistrationDeleted(player)) return "withdrawn";
+  return "active";
+}
+function isPlayerExcludedFromFinalStandings(playerOrRow){
+  const player=playerOrRow?.sourcePlayer||playerOrRow;
+  return getPlayerTournamentStandingStatus(player)==="expelled" && !!player?.excludeFromStandings;
+}
+function standingPlayerStatusLabel(playerOrRow){
+  const status=getPlayerTournamentStandingStatus(playerOrRow);
+  return status==="withdrawn" ? "Withdrawn" : status==="expelled" ? "Expelled" : "";
+}
+function standingPlayerDisplayName(playerOrRow){
+  const name=String(playerOrRow?.name||playerOrRow?.sourcePlayer?.name||"");
+  const label=standingPlayerStatusLabel(playerOrRow);
+  return label ? `${name} [${label}]` : name;
+}
 function getActiveRegistrationPlayers(tournament=getCurrentTournament()){
   return (tournament?.players||[]).filter(player=>!isPlayerRegistrationDeleted(player));
 }
